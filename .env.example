# ============================================
# PQ Golf PIM - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# --- Anthropic AI ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Authentication ---
PIM_PASSWORD=your-secure-password

# --- Shopify app ---
SHOPIFY_API_KEY=your-shopify-client-id
SHOPIFY_API_SECRET=your-shopify-client-secret
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# --- Deployment ---
# Set VITE_API_URL in Vercel Environment Variables:
# VITE_API_URL=https://your-backend.railway.app/api
# Set FRONTEND_URL in Railway Environment Variables:
# FRONTEND_URL=https://your-frontend.vercel.app

# Prisbevakning: timme (0-23, servertid) for nattlig hamtning fran Merchant Center. off = avstangd
PRICE_WATCH_HOUR=4

# Hemlighet for Vercel Cron (nattlig prisbevakning via /api/price-watch/cron). Vercel skickar den som Bearer-token.
CRON_SECRET=
