{
  "name": "pim-multi-store",
  "version": "2.0.0",
  "description": "Multi-Store PIM System for Shopify with Claude AI Integration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "NODE_OPTIONS=--max-http-header-size=65536 vite",
    "dev:server": "node --max-http-header-size=65536 server/index.js",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup": "node -e \"import('./server/db.js').then(m => m.db.testConnection())\"",
    "db:migrate": "psql $DATABASE_URL < database/schema.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@supabase/supabase-js": "^2.95.3",
    "bcryptjs": "^3.0.3",
    "chardet": "^2.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.2.0",
    "iconv-lite": "^0.7.2",
    "lucide-react": "^0.263.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "quill": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-quill": "^2.0.0",
    "sanitize-html": "^2.17.5",
    "serverless-http": "^4.0.0",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.0.0"
  }
}
